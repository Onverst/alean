# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.history/


# -- git hygiene --
# Figma MCP local design context
docs/figma-context/sections/*/variants/*/context.md
docs/figma-context/sections/*/variants/*/reference.png
docs/figma-context/sections/*/variants/*/raw-mcp.md
docs/figma-context/sections/*/compare-*.md

# Visual test runtime artifacts
tests/visual/runtime-screenshots/**
!tests/visual/runtime-screenshots/.gitkeep
test-results/
playwright-report/

# Local Playwright artifacts
playwright/.cache/